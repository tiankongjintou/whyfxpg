# 项目环境变量与密钥配置
# 复制为 .env 后使用

# 数据库路径
WHYFXPG_DB_PATH=whyfxpg/data/whyfxpg.db

# 配置目录
WHYFXPG_CONFIG_DIR=whyfxpg/config

# 日志级别
WHYFXPG_LOG_LEVEL=INFO

# Kimi API (Anthropic兼容)
KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL=kimi-for-coding

# MiniMax API
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# 火山方舟/豆包 API
VOLCANO_API_KEY=your_volcano_api_key
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCANO_MODEL=DeepSeek-V3.2

# 默认LLM供应商
DEFAULT_LLM_PROVIDER=kimi

# 采集限速（秒）
CRAWL_DELAY=2

# 报告输出目录
REPORT_WORD_DIR=whyfxpg/reports/word
REPORT_EXCEL_DIR=whyfxpg/reports/excel
